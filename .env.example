# All VITE_ values are public and bundled into browser code. Never put secrets here.
VITE_BRAND_NAME=Rawatbhata One
# Optional until a domain has been configured; use only an origin, no path.
VITE_SITE_URL=
# Use the project URL and PUBLIC publishable key (or legacy anon JWT).
# Leaving both blank runs the foundation in unconfigured mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
