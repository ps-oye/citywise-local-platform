# All VITE_ values are public and bundled into browser code. Never put secrets here.
VITE_BRAND_NAME=ShaharOne
# One hosted application origin; local navigation remains relative and local pages stay noindex.
VITE_SITE_URL=https://shaharone.in
# Use the project URL and PUBLIC publishable key (or legacy anon JWT).
# Use the EXISTING hosted project; do not provision another project for this update.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
